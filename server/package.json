{
  "name": "auhono-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply auhono --local",
    "db:migrate:remote": "wrangler d1 migrations apply auhono --remote",
    "provision": "node scripts/provision.ts",
    "usage": "wrangler d1 execute auhono --remote --file scripts/usage.sql"
  },
  "dependencies": {
    "hono": "^4.13.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  }
}
